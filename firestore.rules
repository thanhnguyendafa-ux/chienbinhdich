rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function ownsSession(sessionId) {
      return signedIn()
        && get(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerUid == request.auth.uid;
    }

    function validPassThreshold(value) {
      return value is int && value >= 1 && value <= 100;
    }

    function validLessonSetting() {
      return request.resource.data.keys().hasOnly(['passThreshold', 'typingTolerance', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasAny(['passThreshold', 'typingTolerance'])
        && (!('passThreshold' in request.resource.data) || validPassThreshold(request.resource.data.passThreshold))
        && (!('typingTolerance' in request.resource.data) || request.resource.data.typingTolerance is bool)
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /lessonSettings/{setId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validLessonSetting();
      allow delete: if isAdmin();
    }

    match /assignments/{assignmentId} {
      allow get: if isAdmin() || (signedIn() && resource.data.active == true);
      allow list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.id == assignmentId
        && request.resource.data.code == assignmentId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.active == true;

      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.code == resource.data.code
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.setId == resource.data.setId
        && request.resource.data.setVersion == resource.data.setVersion
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == sessionId
        && request.resource.data.schemaVersion == 7
        && (
          !('passThresholdAtStart' in request.resource.data)
          || validPassThreshold(request.resource.data.passThresholdAtStart)
        )
        && (
          !('typingToleranceAtStart' in request.resource.data)
          || request.resource.data.typingToleranceAtStart is bool
        );

      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.id == resource.data.id
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.setId == resource.data.setId
        && request.resource.data.setVersion == resource.data.setVersion
        && request.resource.data.startedAt == resource.data.startedAt
        && (
          (!('passThresholdAtStart' in request.resource.data) && !('passThresholdAtStart' in resource.data))
          || (
            'passThresholdAtStart' in request.resource.data
            && 'passThresholdAtStart' in resource.data
            && request.resource.data.passThresholdAtStart == resource.data.passThresholdAtStart
          )
        )
        && (
          (!('typingToleranceAtStart' in request.resource.data) && !('typingToleranceAtStart' in resource.data))
          || (
            'typingToleranceAtStart' in request.resource.data
            && 'typingToleranceAtStart' in resource.data
            && request.resource.data.typingToleranceAtStart == resource.data.typingToleranceAtStart
          )
        )
        && (
          (!('assignmentId' in request.resource.data) && !('assignmentId' in resource.data))
          || request.resource.data.assignmentId == resource.data.assignmentId
        )
        && (
          (!('accessSlug' in request.resource.data) && !('accessSlug' in resource.data))
          || request.resource.data.accessSlug == resource.data.accessSlug
        )
        && (
          (!('entryMode' in request.resource.data) && !('entryMode' in resource.data))
          || request.resource.data.entryMode == resource.data.entryMode
        );

      allow delete: if false;

      match /attempts/{attemptId} {
        allow read: if isAdmin() || ownsSession(sessionId);

        allow create: if ownsSession(sessionId)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.sessionId == sessionId
          && request.resource.data.id == attemptId;

        allow update: if ownsSession(sessionId)
          && request.resource.data == resource.data;

        allow delete: if false;
      }
    }
  }
}